{
    "name": "daltonmccleery/remote-models",
    "description": "Sometimes you want to use Eloquent, but that data is in another database on a different application.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "eloquent",
        "remote models",
        "remote api"
    ],
    "authors": [
        {
            "name": "Dalton McCleery",
            "homepage": "https://daltonmccleery.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "ext-pdo_sqlite": "*",
        "ext-sqlite3": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.1",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^2.30|^3.0",
        "pestphp/pest-plugin-faker": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.2|^3.0"
    },
    "autoload": {
        "psr-4": {
            "RemoteModels\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RemoteModels\\RemoteModelsServiceProvider"
            ]
        }
    }
}
